<Page
    x:Class="Follower.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel x:Name="Column" Padding="32,16" Spacing="16" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Bot server" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox x:Name="UrlBox" Header="Server URL" PlaceholderText="https://follower.example.com" />
                    <PasswordBox x:Name="TokenBox" Header="API token" />
                    <TextBox x:Name="TzBox" Header="Timezone" PlaceholderText="America/Toronto" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="The token is encrypted with Windows DPAPI, so only your Windows account can read it. Prefer an https:// URL or a private network such as Tailscale: http:// sends the token unencrypted." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save &amp; test" Style="{StaticResource AccentButtonStyle}" Click="SaveTest_Click" />
                        <Button Content="Save" Click="Save_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="AboutText" TextWrapping="Wrap" />
                    <TextBlock Text="Licensed under the Apache License 2.0." Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton Content="Source code" NavigateUri="https://github.com/thom2305/Follower" />
                        <Button Content="Open-source licenses" Click="Licenses_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
