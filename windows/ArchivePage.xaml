<Page
    x:Class="Follower.ArchivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel x:Name="Column" Padding="32,16,32,32" Spacing="12" HorizontalAlignment="Left">
            <TextBlock Text="Archive" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBox x:Name="TextBox" Header="Text contains" KeyDown="Box_KeyDown" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="AuthorBox" Header="Author (name or ID)" KeyDown="Box_KeyDown" />
                <ComboBox x:Name="PickBox" Grid.Column="1" Header="Pick an author" MinWidth="200" VerticalAlignment="Bottom"
                          SelectionChanged="Pick_SelectionChanged" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SearchButton" Content="Search" Style="{StaticResource AccentButtonStyle}" Click="Search_Click" />
                <Button Content="Random" Click="Random_Click" />
            </StackPanel>
            <TextBlock x:Name="ResultsTitle" Style="{StaticResource SubtitleTextBlockStyle}" Visibility="Collapsed" />
            <ListView x:Name="ResultsList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Results_ItemClick"
                      ItemTemplate="{StaticResource PersonRowTemplate}" />
        </StackPanel>
    </ScrollViewer>
</Page>
