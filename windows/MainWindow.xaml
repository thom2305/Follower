<Window
    x:Class="Follower.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="32" ColumnSpacing="10" Padding="14,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image x:Name="AppIcon" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Follower" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        IsTitleBarAutoPaddingEnabled="False"
                        PaneDisplayMode="Auto"
                        IsBackButtonVisible="Visible"
                        IsBackEnabled="False"
                        IsSettingsVisible="True"
                        OpenPaneLength="220"
                        SelectionChanged="Nav_SelectionChanged"
                        BackRequested="Nav_BackRequested">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="People" Tag="people"><NavigationViewItem.Icon><SymbolIcon Symbol="People" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Lookup" Tag="lookup"><NavigationViewItem.Icon><SymbolIcon Symbol="Find" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Birthdays" Tag="birthdays"><NavigationViewItem.Icon><SymbolIcon Symbol="Calendar" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Archive" Tag="archive"><NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
        </NavigationView>

        <InfoBar x:Name="Toast" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                 Margin="16,16,16,24" MaxWidth="640" IsClosable="True" IsOpen="False" />
    </Grid>
</Window>
