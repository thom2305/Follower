<Page
    x:Class="Follower.PersonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Follower">
    <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel x:Name="Column" Padding="32,16,32,32" Spacing="16" HorizontalAlignment="Left">

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PersonPicture x:Name="Pic" Width="72" Height="72" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="UserText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="IdText" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <ProgressRing x:Name="Ring" Width="24" Height="24" IsActive="False" />
                    <Button x:Name="RefreshButton" Click="Refresh_Click" ToolTipService.ToolTip="Refresh from Discord">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="GoneBar" Severity="Warning" IsOpen="False" IsClosable="False"
                     Message="Couldn't fetch this account from Discord (deleted or unavailable). Showing the last saved profile." />

            <Border x:Name="PropsCard" Style="{StaticResource CardBorder}"><StackPanel x:Name="PropsPanel" /></Border>
            <Border x:Name="ChangesCard" Style="{StaticResource CardBorder}" Visibility="Collapsed"><StackPanel x:Name="ChangesPanel" /></Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Relation" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox x:Name="RelationBox" MinWidth="240" SelectionChanged="Relation_SelectionChanged" />
                    <TextBlock x:Name="TrackedText" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="AddToListButton" Content="Add to list" Style="{StaticResource AccentButtonStyle}"
                            Click="AddToList_Click" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border x:Name="TagsCard" Style="{StaticResource CardBorder}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Tags" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <local:WrapPanel x:Name="TagsRepeater" Spacing="8" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TagBox" PlaceholderText="Add tag(s), comma-separated" KeyDown="TagBox_KeyDown" />
                        <Button Grid.Column="1" Content="Add" Click="AddTag_Click" />
                    </Grid>
                    <TextBlock x:Name="SuggestLabel" Text="Existing tags" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <local:WrapPanel x:Name="SuggestRepeater" Spacing="8" />
                </StackPanel>
            </Border>

            <Border x:Name="DetailsCard" Style="{StaticResource CardBorder}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Details" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4" />
                    <StackPanel x:Name="DetailsPanel" />
                    <Button Content="Edit details" Click="Edit_Click" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="4">
                    <TextBlock Text="History" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4" />
                    <StackPanel x:Name="HistoryPanel" />
                    <Button x:Name="HistoryButton" Content="Show history" Click="History_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Button x:Name="RemoveButton" Content="Remove from list" Click="Remove_Click" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</Page>
