# A bot token from discord.dev
DISCORD_TOKEN=

# Your Discord user ID (only you can use the bot)
OWNER_ID=

# MariaDB / MySQL (the database must already exist)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=follower

# Used for birthdays, change if needed
TIMEZONE=America/Toronto

# Biggest attachment (in MB) that gets saved in the database
MAX_ATTACHMENT_MB=8

# API for the apps. Leave API_TOKEN empty to disable the API.
# Make one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_PORT=8080
API_TOKEN=

# Optional: defaults to 0.0.0.0. Use 127.0.0.1 if a tunnel runs on the same machine.
# API_HOST=127.0.0.1
